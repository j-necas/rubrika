# Local development only (rubrika serve/probe from a checkout). The plugin sets its own values in plugin/server/main.py.
RUBRIKA_DATA_DIR=./rubrika-data
# Enable only after checking MZA's access conditions.
RUBRIKA_LIVE_ENABLED=false
# ARON has separate terms of use (no re-publication of scans without the owner's written consent).
# Enable only after assessing https://www.mza.cz/aplikace/podminky-pouziti-aplikace-aron/
RUBRIKA_ARON_ENABLED=false
# Census records app: all rights reserved; 1921 scans are served only in MZA reading rooms (never by this server).
RUBRIKA_CENSUS_ENABLED=false
# MZA indication sketches of the stable cadastre (fund D 9): for viewing only; enable after assessing https://www.mza.cz/indikacniskici/page/view/podminky-uziti-sluzeb
RUBRIKA_SKETCHES_ENABLED=false
# Other archives (all off by default in the server; the plugin enables them). Terms: docs/ARCHIVY.md.
RUBRIKA_VCA_ENABLED=false
RUBRIKA_PF_ENABLED=false
RUBRIKA_PF_LAND_RECORDS_ENABLED=false
RUBRIKA_PF_CENSUS_ENABLED=false
RUBRIKA_SOAPRAHA_ENABLED=false
RUBRIKA_SOAPRAHA_CENSUS_ENABLED=false
RUBRIKA_SOAPRAHA_LAND_RECORDS_ENABLED=false
# SOA Třeboň (DigiArchiv): scans are published for viewing in DigiArchiv only; enable after checking https://digi.ceskearchivy.cz/ and telling the user.
RUBRIKA_TREBON_ENABLED=false
RUBRIKA_TREBON_LAND_RECORDS_ENABLED=false
RUBRIKA_TREBON_CENSUS_ENABLED=false
# AHMP and the National Archives: robots.txt is tolerated for user-triggered requests (see docs/PRAVIDLA.md).
RUBRIKA_AHMP_ENABLED=false
RUBRIKA_NA_ENABLED=false
# National Archives police registrations: plain HTTP host (see docs/PRAVIDLA.md).
RUBRIKA_PRIHLASKY_ENABLED=false
RUBRIKA_REQUEST_INTERVAL=1
# Research never expires unless set (days of inactivity; `rubrika cleanup` then deletes it).
# RUBRIKA_RETENTION_DAYS=365
# Not a quota: after this many archive images in one research the agent pauses and asks whether to go on.
RUBRIKA_CHECKPOINT_IMAGES=100
# Daily caps per archive (or MZA application) protect the archives; see docs/DEVELOPMENT.md.
# RUBRIKA_ACTA_GLOBAL_DAILY_REQUESTS=1000
# RUBRIKA_MZA_IMAGES_GLOBAL_DAILY_REQUESTS=5000
# RUBRIKA_BOOK_DAILY_IMAGES=150
